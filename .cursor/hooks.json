{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": ".cursor/hooks/agent-constitution-gate.sh",
        "matcher": "Write|StrReplace|Delete",
        "timeout": 10,
        "failClosed": true
      },
      {
        "command": ".agents/hooks/agent-test-edit-gate.sh",
        "matcher": "Write|StrReplace",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".agents/hooks/agent-shell-gate.sh",
        "timeout": 10,
        "failClosed": true
      },
      {
        "command": ".agents/hooks/agent-production-gate.sh",
        "timeout": 10,
        "failClosed": true
      },
      {
        "command": "sh .claude/skills/sdlc-mode/hooks/check-push.sh json"
      }
    ],
    "beforeMCPExecution": [
      {
        "command": ".agents/hooks/agent-mcp-gate.sh",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "afterFileEdit": [
      {
        "command": ".agents/hooks/agent-format-after-edit.sh"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "sh .claude/skills/sdlc-mode/hooks/check-reply-shape.sh submit"
      }
    ],
    "afterAgentResponse": [
      {
        "command": "sh .claude/skills/sdlc-mode/hooks/check-reply-shape.sh save"
      }
    ],
    "stop": [
      {
        "command": "sh .claude/skills/sdlc-mode/hooks/check-reply-shape.sh followup",
        "loop_limit": 1
      }
    ],
    "sessionStart": [
      {
        "command": "sh .claude/skills/sdlc-mode/hooks/sdlc-status.sh json"
      }
    ]
  }
}
