[
  {
    "name": "not a push: allowed",
    "input": {
      "tool_input": {
        "command": "git status"
      }
    },
    "expected": "pass"
  },
  {
    "name": "not a push, second tool: allowed",
    "argument": "json",
    "input": {
      "command": "git status",
      "cursor_version": "1.7.2"
    },
    "expected": "{\"permission\":\"allow\"}\n"
  },
  {
    "name": "a push: allowed",
    "input": {
      "tool_input": {
        "command": "git push -u origin feat/x"
      }
    },
    "fileContents": {
      "README.md": "x\n"
    },
    "expected": "pass"
  },
  {
    "name": "a push, the first tool's entry run by the second tool: no output",
    "input": {
      "tool_input": {
        "command": "git push -u origin feat/x"
      },
      "cursor_version": "1.7.2"
    },
    "fileContents": {
      "README.md": "x\n"
    },
    "expected": "pass"
  },
  {
    "name": "a push, second tool: allowed",
    "argument": "json",
    "input": {
      "command": "git -C . push",
      "cursor_version": "1.7.2"
    },
    "fileContents": {
      "README.md": "x\n"
    },
    "expected": "{\"permission\":\"allow\"}\n"
  },
  {
    "name": "a word that only contains push: allowed",
    "input": {
      "tool_input": {
        "command": "git log --grep=pushed"
      }
    },
    "expected": "pass"
  },
  {
    "name": "a push with a global option: allowed",
    "input": {
      "tool_input": {
        "command": "git -c core.quotePath=false push"
      }
    },
    "fileContents": {
      "README.md": "x\n"
    },
    "expected": "pass"
  },
  {
    "name": "a commit message that names a push: allowed",
    "input": {
      "tool_input": {
        "command": "git commit -m \"then git push now\""
      }
    },
    "expected": "pass"
  }
]
