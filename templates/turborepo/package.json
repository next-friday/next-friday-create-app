{
  "name": "next-friday-template-turborepo",
  "version": "0.1.0",
  "private": true,
  "description": "Turborepo workspace with a Next.js application and a Payload CMS backoffice.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/next-friday/next-friday-template-turborepo.git"
  },
  "license": "UNLICENSED",
  "author": "Next Friday",
  "type": "module",
  "scripts": {
    "build": "turbo run build $TURBO_FILTER",
    "check": "node scripts/run-checks.ts rules:check gates:check lint:check sort-package-json:check typecheck knip depcruise test:changed",
    "clean": "rm -rf apps/*/.next apps/*/coverage .turbo coverage *.tsbuildinfo .eslintcache node_modules/.cache",
    "depcruise": "turbo run depcruise $TURBO_FILTER",
    "dev": "turbo run dev --filter=./apps/* --concurrency=10",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache .",
    "gates:check": "node scripts/check-agent-gates.ts",
    "generate:importmap": "pnpm --filter ./apps/backoffice generate:importmap",
    "generate:types": "pnpm --filter ./apps/backoffice generate:types",
    "harness:check": "node scripts/check-harness.ts",
    "knip": "knip",
    "lint": "eslint . --fix --cache --max-warnings=0 --no-inline-config",
    "lint:check": "eslint . --cache --max-warnings=0 --no-inline-config",
    "migrate": "pnpm --filter ./apps/backoffice migrate",
    "migrate:create": "pnpm --filter ./apps/backoffice migrate:create",
    "prepare": "husky && pnpm --filter \"./apps/*\" exec next typegen",
    "rules:check": "node scripts/sync-agent-rules.ts --check",
    "rules:sync": "node scripts/sync-agent-rules.ts",
    "sort-package-json": "sort-package-json package.json \"apps/*/package.json\"",
    "sort-package-json:check": "sort-package-json --check package.json \"apps/*/package.json\"",
    "start": "turbo run start --filter=./apps/* --concurrency=10",
    "test": "turbo run test $TURBO_FILTER",
    "test:changed": "turbo run test:changed $TURBO_FILTER",
    "test:coverage": "turbo run test:coverage $TURBO_FILTER",
    "test:e2e": "turbo run test:e2e $TURBO_FILTER",
    "test:watch": "turbo run test:watch --filter=./apps/*",
    "typecheck": "tsc --noEmit -p tsconfig.json && turbo run typecheck $TURBO_FILTER",
    "verify": "node scripts/run-checks.ts verify:static test:coverage build",
    "verify:static": "node scripts/run-checks.ts rules:check gates:check lint:check format:check sort-package-json:check typecheck knip depcruise"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@next-friday/commitlint-config-friday": "5.2.1",
    "@next-friday/eslint-config-friday": "5.2.1",
    "@next-friday/prettier-config-friday": "5.2.1",
    "@next/eslint-plugin-next": "16.4.5",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "knip": "6.44.2",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sort-package-json": "4.1.0",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "engines": {
    "node": ">=26.13.0 <27"
  }
}
