+const proofSpec = [
+  "# Spec: Health check answers 200",
+  "",
+  "From `intent/health/intent.md`. Status: accepted.",
+  "",
+  requirementsHeading,
+  "",
+  "1. A.",
+  "2. B.",
+  "3. C.",
+  "4. D.",
+  "5. E.",
+  "",
+  "## Design",
+  "",
+  "1. Not a requirement.",
+  "",
+].join("\n");
